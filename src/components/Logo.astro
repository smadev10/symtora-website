---
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" class={cls} aria-hidden="true">
  <rect width="64" height="64" rx="16" fill="#142939" />
  <polyline points="9 35 21 35 27 20 35 45 40 33 55 33" fill="none" stroke="#b9dcf7" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
