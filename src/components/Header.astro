---
import { dict, LANGS, REPO_URL, type Lang } from '../i18n';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
---
<header class="sticky top-0 z-40 border-b border-divider/70 bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href={`/${lang}/`} class="flex items-center gap-2.5" aria-label="Symtora">
      <Logo size={32} />
      <span class="kicker text-[13px] text-strong">Symtora</span>
    </a>

    <nav class="ml-6 hidden items-center gap-6 text-sm font-semibold text-body md:flex">
      <a href="#features" class="hover:text-strong">{t.nav.features}</a>
      <a href="#emergency" class="hover:text-strong">{t.nav.emergency}</a>
      <a href="#screens" class="hover:text-strong">{t.nav.screens}</a>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <div class="flex rounded-[12px] bg-inset p-1 text-xs font-bold" role="group" aria-label={t.a11y.lang}>
        {LANGS.map((l) => (
          <a
            href={`/${l}/`}
            hreflang={l}
            aria-current={l === lang ? 'true' : undefined}
            class:list={[
              'rounded-[9px] px-2.5 py-1.5 uppercase transition-colors',
              l === lang ? 'bg-card text-strong shadow-sm' : 'text-muted hover:text-strong',
            ]}
          >{l}</a>
        ))}
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label={t.a11y.theme}
        title={t.a11y.theme}
        class="grid size-10 place-items-center rounded-[12px] bg-inset text-strong transition-colors hover:bg-badge"
      >
        <Icon name="moon" size={18} class="only-light" />
        <Icon name="sun" size={18} class="only-dark" />
      </button>

      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="hidden size-10 place-items-center rounded-[12px] bg-inset text-strong transition-colors hover:bg-badge sm:grid"
      >
        <Icon name="github" size={18} />
      </a>
    </div>
  </div>
</header>
